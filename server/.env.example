# Copy this file to .env and adjust as needed.

# Local MongoDB (default if MongoDB Community Server is installed & running locally):
MONGODB_URI=mongodb://127.0.0.1:27017/caredesk

# Or, MongoDB Atlas (free cloud cluster) — paste the connection string
# Atlas gives you under "Connect > Drivers", then add your database name:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/caredesk

PORT=5000
